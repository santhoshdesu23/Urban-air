# BreatheWise Environment Variables Configuration
# Copy this file to .env.local for local development.

# ==============================================================================
# AI Provider Configuration (Optional with Automatic Fallback)
# BreatheWise supports multi-key and multi-provider automatic cascading fallback:
# If Key 1 fails or runs out of credits, Key 2 is attempted automatically.
# If an entire provider fails, the secondary provider is attempted.
# If all providers fail or are unconfigured, BreatheWise falls back cleanly
# to its built-in deterministic environmental intelligence engine.
# ==============================================================================

# Preferred AI Provider: "google" or "openai" (optional; auto-detected if omitted)
AI_PROVIDER=

# Primary and Fallback Keys for OpenAI
OPENAI_API_KEY=
OPENAI_API_KEY_1=
OPENAI_API_KEY_2=
OPENAI_MODEL=gpt-4o-mini

# Primary and Fallback Keys for Google Gemini
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY_1=
GOOGLE_GENERATIVE_AI_API_KEY_2=
GOOGLE_MODEL=gemini-3.1-flash-lite

# General Model Override (optional)
AI_MODEL=

# Cloudflare / Vercel AI Gateway Key (optional)
AI_GATEWAY_API_KEY=

# ==============================================================================
# Rate Limiting via Upstash Redis (Optional for Vercel Serverless)
# If omitted, local in-memory fallback rate limiter is used with documented stateless limitation.
# ==============================================================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ==============================================================================
# Application URL
# ==============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
