# BreatheWise Environment Variables Configuration
# Copy this file to .env.local for local development.

# ==============================================================================
# AI Provider Configuration (Optional)
# If no key is provided, BreatheWise uses its built-in deterministic
# environmental reasoning engine with an honest disclosure banner.
# ==============================================================================
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Configurable AI Model identifier (e.g., "openai/gpt-4o-mini", "google/gemini-2.0-flash")
AI_MODEL=

# ==============================================================================
# Rate Limiting via Upstash Redis (Optional for Vercel Serverless)
# If omitted, local in-memory fallback rate limiter is used with documented stateless limitation.
# ==============================================================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ==============================================================================
# Application URL
# ==============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
